<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hungryjjun.worklogapi.notice.NoticeMapper">

    <select id="selectNoticeList" resultType="com.hungryjjun.worklogapi.notice.Notice">
        SELECT notice_seq
             , category
             , title
             , content
             , view_cnt
             , create_emp_no
             , create_at
          FROM notice
         WHERE del_yn = 'N'
         ORDER BY notice_seq DESC
    </select>
</mapper>